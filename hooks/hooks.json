{
  "description": "Git Flow 위반 차단: main과 develop에 직접 커밋, squash 머지, develop에서 hotfix 분기, main이 아닌 커밋에 릴리스 태그",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
